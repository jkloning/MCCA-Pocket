{
    "interface_version": 2,
    "name": "MCCA",
    "label": "交错战线助手",
    "version": "1.7.19",
    "icon": "icon.png",
    "github": "https://github.com/jkloning/MCCA-Pocket",
    "controller": [
        {
            "name": "ADB 默认方式",
            "type": "Adb"
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource/base"
            ],
            "controller": [
                "ADB 默认方式"
            ]
        },
        {
            "name": "B 服",
            "path": [
                "./resource/base",
                "./resource/bilibili"
            ],
            "controller": [
                "ADB 默认方式"
            ]
        }
    ],
    "import": [
        "tasks/MCCA.json"
    ],
    "option": {
        "扫荡次数": {
            "type": "select",
            "cases": [
                {
                    "name": "6次(默认)",
                    "pipeline_override": {
                        "活动_次数起点": {
                            "enabled": true,
                            "next": [
                                "活动_次数加1"
                            ]
                        },
                        "活动_次数加1": {
                            "enabled": true,
                            "next": [
                                "活动_次数加2"
                            ]
                        },
                        "活动_次数加2": {
                            "enabled": true,
                            "next": [
                                "活动_次数加3"
                            ]
                        },
                        "活动_次数加3": {
                            "enabled": true,
                            "next": [
                                "活动_次数加4"
                            ]
                        },
                        "活动_次数加4": {
                            "enabled": true,
                            "next": [
                                "活动_次数加5"
                            ]
                        },
                        "活动_次数加5": {
                            "enabled": true,
                            "next": [
                                "活动_开始战斗"
                            ]
                        }
                    }
                },
                {
                    "name": "1次",
                    "pipeline_override": {
                        "活动_次数起点": {
                            "enabled": true,
                            "next": [
                                "活动_开始战斗"
                            ]
                        }
                    }
                },
                {
                    "name": "2次",
                    "pipeline_override": {
                        "活动_次数起点": {
                            "enabled": true,
                            "next": [
                                "活动_次数加1"
                            ]
                        },
                        "活动_次数加1": {
                            "enabled": true,
                            "next": [
                                "活动_开始战斗"
                            ]
                        }
                    }
                },
                {
                    "name": "3次",
                    "pipeline_override": {
                        "活动_次数起点": {
                            "enabled": true,
                            "next": [
                                "活动_次数加1"
                            ]
                        },
                        "活动_次数加1": {
                            "enabled": true,
                            "next": [
                                "活动_次数加2"
                            ]
                        },
                        "活动_次数加2": {
                            "enabled": true,
                            "next": [
                                "活动_开始战斗"
                            ]
                        }
                    }
                },
                {
                    "name": "4次",
                    "pipeline_override": {
                        "活动_次数起点": {
                            "enabled": true,
                            "next": [
                                "活动_次数加1"
                            ]
                        },
                        "活动_次数加1": {
                            "enabled": true,
                            "next": [
                                "活动_次数加2"
                            ]
                        },
                        "活动_次数加2": {
                            "enabled": true,
                            "next": [
                                "活动_次数加3"
                            ]
                        },
                        "活动_次数加3": {
                            "enabled": true,
                            "next": [
                                "活动_开始战斗"
                            ]
                        }
                    }
                },
                {
                    "name": "5次",
                    "pipeline_override": {
                        "活动_次数起点": {
                            "enabled": true,
                            "next": [
                                "活动_次数加1"
                            ]
                        },
                        "活动_次数加1": {
                            "enabled": true,
                            "next": [
                                "活动_次数加2"
                            ]
                        },
                        "活动_次数加2": {
                            "enabled": true,
                            "next": [
                                "活动_次数加3"
                            ]
                        },
                        "活动_次数加3": {
                            "enabled": true,
                            "next": [
                                "活动_次数加4"
                            ]
                        },
                        "活动_次数加4": {
                            "enabled": true,
                            "next": [
                                "活动_开始战斗"
                            ]
                        }
                    }
                }
            ]
        },
        "刷新战力阈值": {
            "type": "select",
            "cases": [
                {
                    "name": "5000",
                    "pipeline_override": {
                        "模拟军演_刷新对手": {
                            "expected": "^([5-9]\\d{3}|[1-9]\\d{4})$"
                        }
                    }
                },
                {
                    "name": "10000",
                    "pipeline_override": {
                        "模拟军演_刷新对手": {
                            "expected": "^[1-9]\\d{4}$"
                        }
                    }
                },
                {
                    "name": "20000",
                    "pipeline_override": {
                        "模拟军演_刷新对手": {
                            "expected": "^([2-9]\\d{4})$"
                        }
                    }
                },
                {
                    "name": "30000",
                    "pipeline_override": {
                        "模拟军演_刷新对手": {
                            "expected": "^([3-9]\\d{4})$"
                        }
                    }
                }
            ]
        },
        "是否访问每个好友换抽": {
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {
                        "Infr_DealNextFriends": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "Infr_DealNextFriends": {
                            "enabled": false
                        }
                    }
                }
            ]
        }
    }
}
